     public static final double FLIGHT_COST_PER_MIN = 0.5; // Flight cost per minute
 
     // Algorithm-related parameters
-    private static final int MAX_ITERATIONS = 500; // Maximum number of iterations
+    private static final int MAX_ITERATIONS = Integer.getInteger("iters",500);
+    public static final double LAM = Double.parseDouble(System.getProperty("lam","0"));
+    private static final double SECS = Double.parseDouble(System.getProperty("secs","0"));
+    public static double mkfix(List<List<List<List<Node>>>> r, int[] t, double sp){ double mk=0; for(int s=0;s<r.size();s++){ double sum=0; for(List<List<Node>> d: r.get(s)){ double x=Check.calculateDroneTime(d,sp); sum+=x; mk=Math.max(mk,x);} if(t[s]==1) mk=Math.max(mk,sum);} return mk; } // Maximum number of iterations
+    // ---- WX-E6 coverage extension (v6): the author's location-feasibility test (every target covered by an opened
+    // station) is extended to every point of the emergency-demand support Omega read from -Dcov=<file> ("x y" lines).
+    // Without -Dcov the algorithm is bit-for-bit the author's TSALNS (+ budget/IO patch). ----
+    public static final double[][] COV = loadCov(System.getProperty("cov", ""));
+    static double[][] loadCov(String f) {
+        if (f == null || f.isEmpty()) return new double[0][];
+        try {
+            java.util.List<double[]> L = new java.util.ArrayList<>();
+            for (String l : java.nio.file.Files.readAllLines(java.nio.file.Paths.get(f))) {
+                l = l.trim(); if (l.isEmpty()) continue;
+                String[] p = l.split("\\s+"); L.add(new double[]{Double.parseDouble(p[0]), Double.parseDouble(p[1])});
+            }
+            return L.toArray(new double[0][]);
+        } catch (Exception e) { throw new RuntimeException("cannot read -Dcov file " + f, e); }
+    }
+    static boolean covered(double[] w, int[] t, Node[] st) {
+        for (int i = 0; i < st.length; i++) {
+            if (t[i] == 0) continue;
+            double r = (t[i] == 1) ? SMALL_RADIUS : LARGE_RADIUS;
+            if (Math.hypot(w[0] - st[i].getX(), w[1] - st[i].getY()) <= r + 1e-6) return true;
+        }
+        return false;
+    }
+    public static boolean covOK(int[] t, Node[] st) {
+        for (double[] w : COV) if (!covered(w, t, st)) return false;
+        return true;
+    }
+    /** Author-style greedy initial repair (same rule as Init.stationSet: pick the (station, type) covering the most
+     *  still-uncovered points; upgrades of opened SABS allowed). Terminates because every Omega point is coverable. */
+    public static int[] covInit(int[] t0, Node[] st) {
+        int[] t = t0.clone();
+        for (int guard = 0; guard < 4 * st.length && !covOK(t, st); guard++) {
+            int bi = -1, bt = 0, bc = 0;
+            for (int i = 0; i < st.length; i++) for (int ty = Math.max(1, t[i] + 1); ty <= 2; ty++) {
+                int[] tt = t.clone(); tt[i] = ty; int c = 0;
+                for (double[] w : COV) if (!covered(w, t, st) && covered(w, tt, st)) c++;
+                if (c > bc) { bc = c; bi = i; bt = ty; }
+            }
+            if (bi < 0) break;
+            t[bi] = bt;
+        }
+        return t;
+    }
