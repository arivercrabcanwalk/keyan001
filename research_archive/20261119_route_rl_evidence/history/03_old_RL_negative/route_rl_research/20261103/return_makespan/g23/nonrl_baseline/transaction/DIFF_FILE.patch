+def _neighbours(solution):
+    """Yield deterministic same-station physical route edits."""
+    base = solution["routes"]
+
+    # Reverse every segment of each trip (all 2-opt order reversals).
+    for si, station in enumerate(base):
+        for slot, trips in enumerate(station):
+            for ti, trip in enumerate(trips):
+                for left in range(len(trip)):
+                    for right in range(left + 1, len(trip)):
+                        out = deepcopy(base)
+                        out[si][slot][ti][left:right + 1] = reversed(
+                            out[si][slot][ti][left:right + 1])
+                        yield "two_opt", out, si
+
+    # Relocate one target among trips and slots within its fixed station.
+    locations = list(_route_locations(solution))
+    for src_si, src_slot, src_ti, src_pi, nid in locations:
+        station_slots = (1,) if solution["station_types"][src_si] == 1 else (0, 1)
+        for dst_slot in station_slots:
+            for dst_ti in range(len(base[src_si][dst_slot])):
+                if (src_slot == dst_slot and src_ti == dst_ti
+                        and len(base[src_si][src_slot][src_ti]) == 1):
+                    continue
+                out = deepcopy(base)
+                moved = out[src_si][src_slot][src_ti].pop(src_pi)
+                if not out[src_si][src_slot][src_ti]:
+                    out[src_si][src_slot].pop(src_ti)
+                    if src_slot == dst_slot and src_ti < dst_ti:
+                        dst_ti -= 1
+                out[src_si][dst_slot][dst_ti].append(moved)
+                yield "relocate", out, src_si
+            # A singleton trip split is a first-class route decision.
+            out = deepcopy(base)
+            out[src_si][src_slot][src_ti].pop(src_pi)
+            if not out[src_si][src_slot][src_ti]:
+                out[src_si][src_slot].pop(src_ti)
+            out[src_si][dst_slot].append([nid])
+            yield "split_relocate", out, src_si
+
+    # Swap targets across trips/slots while preserving exact target coverage.
+    for a, b in combinations(locations, 2):
+        asi, ad, ati, api, an = a
+        bsi, bd, bti, bpi, bn = b
+        if asi != bsi or (ad, ati, api) == (bd, bti, bpi):
+            continue
+        out = deepcopy(base)
+        out[asi][ad][ati][api], out[bsi][bd][bti][bpi] = bn, an
+        yield "swap", out, asi
+
+    # Merge two trips in either order; may move a complete trip between slots.
+    for si, station in enumerate(base):
+        for src_slot in (0, 1):
+            for src_ti in range(len(station[src_slot])):
+                for dst_slot in (0, 1):
+                    for dst_ti in range(len(station[dst_slot])):
+                        if (src_slot, src_ti) == (dst_slot, dst_ti):
+                            continue
+                        for reverse in (False, True):
+                            out = deepcopy(base)
+                            source = list(out[si][src_slot][src_ti])
+                            target = out[si][dst_slot][dst_ti]
+                            merged = list(target) + source if reverse else source + list(target)
+                            # Delete high indexes first when both trips share a slot.
+                            refs = sorted(((src_slot, src_ti), (dst_slot, dst_ti)),
+                                          key=lambda x: (x[0], x[1]), reverse=True)
+                            for d, ti in refs:
+                                out[si][d].pop(ti)
+                            # Destination index after source deletion.
+                            insert_at = dst_ti
+                            if src_slot == dst_slot and src_ti < dst_ti:
+                                insert_at -= 1
+                            out[si][dst_slot].insert(insert_at, merged)
+                            yield "merge", out, si
+
