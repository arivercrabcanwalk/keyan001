+def _route_locations(solution):
+    for si, station in enumerate(solution["routes"]):
+        for slot, trips in enumerate(station):
+            for ti, trip in enumerate(trips):
+                for pi, nid in enumerate(trip):
+                    yield si, slot, ti, pi, nid
+
