+def _duration(instance, station_idx, trip):
+    station = instance.stations[station_idx]
+    nodes = [instance.nodes[nid] for nid in trip]
+    sequence = [station] + nodes + [station]
+    distance = sum(math.hypot(a.x - b.x, a.y - b.y)
+                   for a, b in zip(sequence, sequence[1:]))
+    return distance / instance.params.speed + sum(n.service for n in nodes)
+
+
+def _energy(instance, station_idx, trip):
+    station = instance.stations[station_idx]
+    nodes = [instance.nodes[nid] for nid in trip]
+    sequence = [station] + nodes + [station]
+    distance = sum(math.hypot(a.x - b.x, a.y - b.y)
+                   for a, b in zip(sequence, sequence[1:]))
+    return (distance / instance.params.speed * instance.params.flight_energy
+            + sum(n.energy for n in nodes))
+
+
+def _lpt_repack(instance, anchor):
+    """Assign intact trips to eligible station slots in longest-first order."""
+    candidate = anchor.solution()
+    for si, kind in enumerate(anchor.station_types):
+        original_routes = deepcopy(candidate["routes"][si])
+        trips = [list(trip) for slot in candidate["routes"][si] for trip in slot if trip]
+        slots = (1,) if kind == 1 else (0, 1)
+        loads = {slot: 0.0 for slot in slots}
+        rebuilt = [[], []]
+        for trip in sorted(trips, key=lambda t: (-_duration(instance, si, t), tuple(t))):
+            duration = _duration(instance, si, trip)
+            energy = _energy(instance, si, trip)
+            feasible_slots = []
+            for slot in slots:
+                capacity = (instance.params.large_battery if slot == 0
+                            else instance.params.small_battery)
+                duty_limit = (instance.params.large_duration
+                              if kind == 2 and slot == 0
+                              else instance.params.small_duration)
+                if (energy <= capacity + 1e-7
+                        and loads[slot] + duration <= duty_limit + 1e-7):
+                    feasible_slots.append(slot)
+            # LPT considers the lightest slot among those that can physically
+            # carry the intact trip; the full-map scorer remains authoritative.
+            for slot in sorted(feasible_slots, key=lambda d: (loads[d], d)):
+                rebuilt[slot].append(list(trip))
+                loads[slot] += duration
+                break
+            else:
+                rebuilt = original_routes
+                break
+        candidate["routes"][si] = rebuilt
+    return candidate
+
